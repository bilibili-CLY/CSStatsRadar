# OS/editor noise
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/
.opencode/

# Local environment and tool caches
.env
.env.*
.venv/
.tools/

# Local planning/task documents
Doc/

# Python leftovers from earlier prototypes
__pycache__/
.pytest_cache/
*.py[cod]

# .NET build outputs
**/bin/
**/obj/
*.user
publish/
artifacts/

# Frontend/package-manager outputs
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tsbuildinfo
frontend/vite.config.js
frontend/vite.config.d.ts
frontend/package.json.md5

# The desktop shell embeds the production frontend at package time;
# dist is a build artifact and must NOT be committed.
frontend/dist/

# Tauri build inputs/outputs (generated, never committed)
frontend/src-tauri/staged/
frontend/src-tauri/target/
frontend/src-tauri/WixTools/
frontend/src-tauri/gen/
# No committed Cargo.lock: the shell resolves its own dependency graph at build time.
frontend/src-tauri/Cargo.lock

# Local runtime data
tmp/
temp/
uploads/
*.log
